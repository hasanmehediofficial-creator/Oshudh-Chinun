{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Oshudh Chinun Medicine Dataset",
  "type": "object",
  "required": ["schemaVersion", "datasetVersion", "records"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "publishedAt": { "type": ["string", "null"], "format": "date-time" },
    "sourcePolicy": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "brand", "generic", "form", "priceType", "verificationStatus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "brand": { "type": "string", "minLength": 1 },
          "generic": { "type": "string" },
          "strength": { "type": ["string", "null"] },
          "form": { "type": "string" },
          "manufacturer": { "type": ["string", "null"] },
          "packSize": { "type": ["string", "null"] },
          "price": { "type": ["number", "null"], "minimum": 0 },
          "priceType": { "enum": ["official_mrp", "manufacturer_list_price", "retail_observed", "unknown"] },
          "priceCurrency": { "const": "BDT" },
          "priceSource": { "type": ["string", "null"], "format": "uri" },
          "priceCheckedAt": { "type": ["string", "null"], "format": "date-time" },
          "indications": { "type": "array", "items": { "type": "string" } },
          "sideEffects": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "interactions": { "type": "array", "items": { "type": "string" } },
          "pregnancyInfo": { "type": ["string", "null"] },
          "clinicalSource": { "type": ["string", "null"], "format": "uri" },
          "clinicalReviewedAt": { "type": ["string", "null"], "format": "date-time" },
          "verificationStatus": { "enum": ["verified", "unverified", "unverified_sample"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}